{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IR/SEC Source Candidate",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "candidate_id",
    "case_id",
    "ticker",
    "company_name",
    "exchange",
    "fiscal_period",
    "source_type",
    "source_url_or_ref",
    "source_domain",
    "source_terms_url",
    "robots_url",
    "rights_status",
    "rights_tier",
    "source_terms_checked",
    "robots_checked",
    "paywall_or_login_required",
    "raw_transcript_allowed",
    "raw_audio_allowed",
    "raw_video_allowed",
    "raw_slides_allowed",
    "commit_allowed",
    "eval_allowed",
    "training_allowed",
    "metadata_only",
    "blocked_reason_code",
    "manual_action",
    "last_checked_at",
    "provenance_hash"
  ],
  "properties": {
    "candidate_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "ticker": { "type": "string", "minLength": 1 },
    "company_name": { "type": "string", "minLength": 1 },
    "exchange": { "type": "string", "const": "NYSE" },
    "fiscal_period": { "type": "string", "minLength": 1 },
    "source_type": {
      "type": "string",
      "enum": [
        "official_ir_metadata",
        "official_ir_permitted_raw",
        "sec_edgar_metadata",
        "sec_exhibit_metadata",
        "manual_local",
        "blocked_restricted"
      ]
    },
    "source_url_or_ref": { "type": "string", "minLength": 1 },
    "source_domain": { "type": "string" },
    "source_terms_url": { "type": "string" },
    "robots_url": { "type": "string" },
    "rights_status": { "type": "string" },
    "rights_tier": { "type": "string" },
    "source_terms_checked": { "type": "boolean" },
    "robots_checked": { "type": "boolean" },
    "paywall_or_login_required": { "type": "boolean" },
    "raw_transcript_allowed": { "type": "boolean" },
    "raw_audio_allowed": { "type": "boolean" },
    "raw_video_allowed": { "type": "boolean" },
    "raw_slides_allowed": { "type": "boolean" },
    "commit_allowed": { "type": "boolean" },
    "eval_allowed": { "type": "boolean" },
    "training_allowed": { "type": "boolean" },
    "metadata_only": { "type": "boolean", "default": true },
    "blocked_reason_code": { "type": "string" },
    "manual_action": { "type": "string" },
    "last_checked_at": { "type": "string" },
    "provenance_hash": { "type": "string", "pattern": "^sha256:" }
  },
  "description": "Raw use requires explicit checked source terms/robots or approval_ref. Vendor raw use requires license_config_ref. Unknown rights block raw use. Candidate rows must not contain raw transcript, audio, video, slide, or filing body content fields."
}
