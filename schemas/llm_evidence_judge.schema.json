{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-engine.local/schemas/llm_evidence_judge.schema.json",
  "title": "Signal Engine LLM Evidence Judge Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "provider",
    "model",
    "output_role",
    "canonical_output",
    "judgments"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "llm_evidence_judge.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "output_role": {"type": "string", "enum": ["reviewer"]},
    "canonical_output": {"type": "boolean", "const": false},
    "judgments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "verdict",
          "evidence_supported",
          "evidence_quote",
          "provenance_ref",
          "reason"
        ],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "verdict": {"type": "string", "enum": ["supported", "unsupported", "uncertain"]},
          "evidence_supported": {"type": "boolean"},
          "evidence_quote": {"type": "string", "minLength": 1},
          "provenance_ref": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
