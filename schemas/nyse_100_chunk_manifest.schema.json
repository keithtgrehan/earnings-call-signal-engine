{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NYSE 100 chunk manifest row",
  "type": "object",
  "required": [
    "chunk_id",
    "case_id",
    "ticker",
    "asset_id",
    "asset_type",
    "chunk_type",
    "section",
    "speaker_role",
    "source_sha256",
    "text_sha256",
    "local_chunk_path",
    "start_char",
    "end_char",
    "start_time_sec",
    "end_time_sec",
    "rights_status",
    "rag_eligible",
    "raw_text_committed"
  ],
  "properties": {
    "chunk_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "ticker": {"type": "string", "minLength": 1},
    "asset_id": {"type": "string", "minLength": 1},
    "asset_type": {"type": "string", "enum": ["transcript", "audio", "metadata"]},
    "chunk_type": {"type": "string", "enum": ["transcript_text", "audio_asr_text", "metadata_only"]},
    "section": {"type": "string"},
    "speaker_role": {"type": "string"},
    "source_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "text_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "local_chunk_path": {"type": "string"},
    "start_char": {"type": ["integer", "string"]},
    "end_char": {"type": ["integer", "string"]},
    "start_time_sec": {"type": ["number", "string", "null"]},
    "end_time_sec": {"type": ["number", "string", "null"]},
    "rights_status": {"type": "string", "enum": ["safe_to_download", "rights_cleared", "manual_local_review_only"]},
    "rag_eligible": {"enum": [true, false, "true", "false"]},
    "raw_text_committed": {"enum": [false, "false"]}
  },
  "additionalProperties": false
}
