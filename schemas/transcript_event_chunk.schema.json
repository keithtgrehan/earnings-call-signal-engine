{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-engine.local/schemas/transcript_event_chunk.schema.json",
  "title": "Transcript event chunk metadata",
  "type": "object",
  "required": [
    "chunk_id",
    "case_id",
    "ticker",
    "chunk_type",
    "source_sha256",
    "text_sha256",
    "local_chunk_path",
    "start_char",
    "end_char",
    "rights_status",
    "raw_text_committed"
  ],
  "properties": {
    "chunk_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "ticker": {"type": "string"},
    "chunk_type": {
      "type": "string",
      "enum": [
        "prepared_remarks",
        "guidance_statement",
        "guidance_revision_candidate",
        "qa_question",
        "qa_answer",
        "qa_pair",
        "analyst_pressure_exchange",
        "management_hedging_span",
        "uncertainty_span",
        "reassurance_span",
        "answer_shift_candidate",
        "evidence_object",
        "semantic_fallback"
      ]
    },
    "source_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "text_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "local_chunk_path": {"type": "string"},
    "start_char": {"type": "integer", "minimum": 0},
    "end_char": {"type": "integer", "minimum": 0},
    "rights_status": {"type": "string"},
    "raw_text_committed": {"const": false}
  },
  "additionalProperties": true
}
