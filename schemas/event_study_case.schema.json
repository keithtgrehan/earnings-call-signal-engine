{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-engine.local/schemas/event_study_case.schema.json",
  "title": "Signal Engine Event Study Case",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "event_id",
    "event_date",
    "event_datetime",
    "event_timezone",
    "price_data_status",
    "benchmark_proxy",
    "sector_proxy",
    "event_window",
    "estimation_window",
    "expected_return_model",
    "earnings_surprise_control_status",
    "confounder_notes",
    "gold_signal_join_status",
    "significance_claim_allowed",
    "controls",
    "outputs",
    "failure_modes",
    "benchmark_gating",
    "exploratory_only",
    "claim_limitations",
    "source_id",
    "source_name",
    "source_url_or_path",
    "source_type",
    "rights_tier",
    "license_or_terms_summary",
    "allowed_storage",
    "allowed_commit",
    "commit_allowed",
    "allowed_training_use",
    "training_allowed",
    "allowed_eval_use",
    "eval_allowed",
    "raw_body_allowed",
    "metadata_only",
    "acquisition_method",
    "robots_or_terms_checked",
    "source_terms_checked",
    "paywall_or_login_status",
    "robots_status",
    "provenance_hash",
    "last_checked_at",
    "reviewer_or_operator",
    "blocked_reason",
    "notes"
  ],
  "properties": {
    "event_id": {"type": "string"},
    "event_date": {"type": "string"},
    "event_datetime": {"type": "string"},
    "event_timezone": {"type": "string"},
    "event_timestamp": {"type": "string"},
    "price_data_status": {"type": "string"},
    "benchmark_proxy": {"type": "string"},
    "sector_proxy": {"type": "string"},
    "event_window": {"type": "string"},
    "estimation_window": {"type": "string"},
    "expected_return_model": {
      "type": "string",
      "enum": ["market_adjusted", "sector_adjusted", "market_model"]
    },
    "earnings_surprise_control_status": {"type": "string"},
    "confounder_notes": {"type": "string"},
    "gold_signal_join_status": {"type": "string"},
    "significance_claim_allowed": {"type": "boolean", "const": false},
    "controls": {
      "type": "object",
      "required": ["earnings_surprise", "sector_return", "market_return"],
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "required": ["abnormal_return", "cumulative_abnormal_return"],
      "additionalProperties": true
    },
    "failure_modes": {"type": "array", "items": {"type": "string"}},
    "benchmark_gating": {"type": "object", "additionalProperties": true},
    "exploratory_only": {"type": "boolean", "const": true},
    "claim_limitations": {"type": "string"},
    "source_id": {"type": "string"},
    "source_name": {"type": "string"},
    "source_url_or_path": {"type": "string"},
    "source_type": {"type": "string"},
    "rights_tier": {"type": "string"},
    "license_or_terms_summary": {"type": "string"},
    "allowed_storage": {"type": "string"},
    "allowed_commit": {"type": "boolean"},
    "commit_allowed": {"type": "boolean"},
    "allowed_training_use": {"type": "string"},
    "training_allowed": {"type": "string"},
    "allowed_eval_use": {"type": "string"},
    "eval_allowed": {"type": "string"},
    "raw_body_allowed": {"type": "boolean"},
    "metadata_only": {"type": "boolean"},
    "acquisition_method": {"type": "string"},
    "robots_or_terms_checked": {"type": "boolean"},
    "source_terms_checked": {"type": "boolean"},
    "paywall_or_login_status": {"type": "string"},
    "robots_status": {"type": "string"},
    "provenance_hash": {"type": "string"},
    "last_checked_at": {"type": "string"},
    "reviewer_or_operator": {"type": "string"},
    "blocked_reason": {"type": "string"},
    "notes": {"type": "string"}
  }
}
