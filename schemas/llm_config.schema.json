{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-engine.local/schemas/llm_config.schema.json",
  "title": "Signal Engine Optional LLM Backend Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "enabled",
    "allow_live_provider_calls",
    "canonical_output_allowed",
    "auto_promote_gold",
    "allowed_use_cases",
    "allowed_output_roots",
    "default_provider",
    "providers"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "llm_backends.v1"},
    "enabled": {"type": "boolean"},
    "allow_live_provider_calls": {"type": "boolean"},
    "canonical_output_allowed": {"type": "boolean", "const": false},
    "auto_promote_gold": {"type": "boolean", "const": false},
    "allowed_use_cases": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "enum": ["reviewer_support", "extraction_benchmark"]}
    },
    "allowed_output_roots": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "enum": ["artifacts/llm", "reports/llm"]}
    },
    "default_provider": {"type": "string", "enum": ["dry_run", "claude", "glm52"]},
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dry_run", "claude", "glm52"],
      "properties": {
        "dry_run": {"$ref": "#/$defs/provider"},
        "claude": {"$ref": "#/$defs/provider"},
        "glm52": {"$ref": "#/$defs/provider"}
      }
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_type",
        "enabled",
        "default_model",
        "model_env_var_name",
        "secret_env_var_name",
        "base_url_env_var_name",
        "notes"
      ],
      "properties": {
        "provider_type": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"},
        "default_model": {"type": "string"},
        "model_env_var_name": {"type": "string"},
        "secret_env_var_name": {"type": "string"},
        "base_url_env_var_name": {"type": "string"},
        "notes": {"type": "string"}
      }
    }
  }
}
