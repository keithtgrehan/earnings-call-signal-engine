{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-engine.local/schemas/llm_config.schema.json",
  "title": "Signal Engine Optional LLM Backend Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "llm", "providers"],
  "properties": {
    "schema_version": {"type": "string", "const": "llm_backends.v1"},
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "provider",
        "mode",
        "allow_network",
        "require_live_flag",
        "require_quote_evidence",
        "require_json_schema",
        "canonical_output",
        "auto_promote_gold",
        "output_dir",
        "report_dir",
        "max_calls",
        "max_cost_usd",
        "allowed_use_cases"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "provider": {"type": "string", "enum": ["dry_run", "claude", "glm52", "openai_compatible"]},
        "mode": {"type": "string", "enum": ["dry_run", "live"]},
        "allow_network": {"type": "boolean"},
        "require_live_flag": {"type": "boolean", "const": true},
        "require_quote_evidence": {"type": "boolean", "const": true},
        "require_json_schema": {"type": "boolean", "const": true},
        "canonical_output": {"type": "boolean", "const": false},
        "auto_promote_gold": {"type": "boolean", "const": false},
        "output_dir": {"type": "string", "enum": ["artifacts/llm"]},
        "report_dir": {"type": "string", "enum": ["reports/llm"]},
        "max_calls": {"type": "integer", "minimum": 0},
        "max_cost_usd": {"type": "number", "minimum": 0},
        "allowed_use_cases": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["reviewer_support", "extraction_benchmark"]}
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dry_run", "claude", "glm52", "openai_compatible"],
      "properties": {
        "dry_run": {"$ref": "#/$defs/provider"},
        "claude": {"$ref": "#/$defs/provider"},
        "glm52": {"$ref": "#/$defs/provider"},
        "openai_compatible": {"$ref": "#/$defs/provider"}
      }
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_type",
        "enabled",
        "default_model",
        "model_env",
        "api_key_env",
        "base_url_env",
        "notes"
      ],
      "properties": {
        "provider_type": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"},
        "default_model": {"type": "string"},
        "model_env": {"type": "string"},
        "api_key_env": {"type": "string"},
        "base_url_env": {"type": "string"},
        "notes": {"type": "string"}
      }
    }
  }
}
