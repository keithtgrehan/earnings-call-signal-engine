{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-engine.local/schemas/training_plan.schema.json",
  "title": "Signal Engine Training Plan",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "task_name",
    "task_type",
    "allowed_sources",
    "forbidden_sources",
    "gold_label_path",
    "rights_registry_path",
    "min_gold_labels",
    "min_reviewers",
    "label_schema_version",
    "external_datasets_allowed",
    "external_datasets_mode",
    "output_artifact_policy",
    "model_family",
    "training_enabled",
    "reason_if_disabled",
    "evaluation_metrics",
    "leakage_checks",
    "claim_limits"
  ],
  "properties": {
    "task_name": {"type": "string", "minLength": 1},
    "task_type": {"type": "string", "minLength": 1},
    "allowed_sources": {"type": "array"},
    "forbidden_sources": {"type": "array", "items": {"type": "string"}},
    "gold_label_path": {"type": "string", "minLength": 1},
    "rights_registry_path": {"type": "string", "minLength": 1},
    "min_gold_labels": {"type": "integer", "minimum": 1},
    "min_reviewers": {"type": "integer", "minimum": 1},
    "label_schema_version": {"type": "string", "minLength": 1},
    "external_datasets_allowed": {"type": "boolean", "const": false},
    "external_datasets_mode": {"type": "string", "enum": ["benchmark_only"]},
    "output_artifact_policy": {"type": "string", "enum": ["no_model_weights_committed"]},
    "output_path_policy": {"type": "string", "enum": ["tmp_only"]},
    "model_family": {"type": "string", "enum": ["sklearn_baseline", "transformer_candidate", "llm_reviewer"]},
    "training_enabled": {"type": "boolean"},
    "reason_if_disabled": {"type": "string"},
    "evaluation_metrics": {"type": "array", "items": {"type": "string"}},
    "leakage_checks": {"type": "array", "items": {"type": "string"}},
    "claim_limits": {"type": "array", "items": {"type": "string"}},
    "canonical_output_allowed": {"type": "boolean", "const": false},
    "llm_reviewer_canonical_allowed": {"type": "boolean", "const": false},
    "synthetic_smoke_training_allowed": {"type": "boolean"},
    "dependency_policy": {"type": "object", "additionalProperties": true},
    "database_policy": {"type": "object", "additionalProperties": true},
    "training_data_inventory": {"type": "object", "additionalProperties": true}
  }
}
