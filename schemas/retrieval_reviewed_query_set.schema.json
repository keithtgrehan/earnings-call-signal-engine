{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-engine.local/schemas/retrieval_reviewed_query_set.schema.json",
  "title": "Signal Engine reviewed retrieval query-set row",
  "type": "object",
  "required": [
    "query_id",
    "case_id",
    "query_type",
    "query_text_or_safe_query_label",
    "expected_object_ids",
    "expected_object_types",
    "expected_topics",
    "evidence_object_id_refs",
    "provenance_refs",
    "reviewer",
    "reviewed_at",
    "review_status",
    "benchmark_eligible",
    "notes"
  ],
  "properties": {
    "query_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "query_type": {
      "enum": [
        "positive_evidence_lookup",
        "metadata_category_lookup",
        "abstention_guardrail",
        "qna_abstention",
        "negative_control",
        "guidance_revision_lookup",
        "uncertainty_language_lookup",
        "analyst_pressure_lookup",
        "topic_lookup",
        "evidence_object_lookup",
        "case_comparison_lookup"
      ]
    },
    "query_text_or_safe_query_label": {"type": "string", "minLength": 1},
    "expected_object_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^rom_(semantic|event|evidence)_[0-9a-f]{16}$"}
    },
    "expected_object_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "semantic_chunk_metadata",
          "event_aligned_chunk_metadata",
          "evidence_object_metadata"
        ]
      }
    },
    "expected_topics": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_object_id_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^rom_evidence_[0-9a-f]{16}$"}
    },
    "provenance_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "reviewer": {"type": "string"},
    "reviewed_at": {"type": "string"},
    "review_status": {
      "enum": [
        "template_only",
        "smoke_only",
        "review_pending",
        "reviewed",
        "rejected"
      ]
    },
    "benchmark_eligible": {"type": "boolean"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
