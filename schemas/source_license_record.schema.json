{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-engine.local/schemas/source_license_record.schema.json",
  "title": "Signal Engine Source License Record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "source_id",
    "source_name",
    "source_url_or_path",
    "source_type",
    "rights_tier",
    "license_or_terms_summary",
    "allowed_storage",
    "allowed_commit",
    "commit_allowed",
    "allowed_training_use",
    "training_allowed",
    "allowed_eval_use",
    "eval_allowed",
    "raw_body_allowed",
    "metadata_only",
    "acquisition_method",
    "robots_or_terms_checked",
    "source_terms_checked",
    "paywall_or_login_status",
    "robots_status",
    "provenance_hash",
    "last_checked_at",
    "reviewer_or_operator",
    "blocked_reason",
    "notes"
  ],
  "properties": {
    "source_id": {"type": "string", "minLength": 1},
    "source_name": {"type": "string", "minLength": 1},
    "source_url_or_path": {"type": "string", "minLength": 1},
    "source_type": {"type": "string"},
    "rights_tier": {"type": "string"},
    "license_or_terms_summary": {"type": "string"},
    "allowed_storage": {"type": "string"},
    "allowed_commit": {"type": "boolean"},
    "commit_allowed": {"type": "boolean"},
    "allowed_training_use": {"type": "string"},
    "training_allowed": {"type": "string"},
    "allowed_eval_use": {"type": "string"},
    "eval_allowed": {"type": "string"},
    "raw_body_allowed": {"type": "boolean"},
    "metadata_only": {"type": "boolean"},
    "acquisition_method": {"type": "string"},
    "robots_or_terms_checked": {"type": "boolean"},
    "source_terms_checked": {"type": "boolean"},
    "paywall_or_login_status": {"type": "string"},
    "robots_status": {"type": "string"},
    "provenance_hash": {"type": "string", "minLength": 1},
    "last_checked_at": {"type": "string", "minLength": 1},
    "reviewer_or_operator": {"type": "string", "minLength": 1},
    "blocked_reason": {"type": "string"},
    "notes": {"type": "string"}
  }
}
