{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-engine.local/schemas/audio_feature.schema.json",
  "title": "Neutral audio feature metadata",
  "type": "object",
  "required": ["case_id", "audio_sha256", "feature_name", "label_type"],
  "properties": {
    "case_id": {"type": "string"},
    "audio_sha256": {"type": "string"},
    "feature_name": {
      "enum": [
        "pause_duration",
        "speech_rate",
        "filler_count",
        "pitch_f0_summary",
        "energy_summary",
        "asr_confidence",
        "diarization_confidence",
        "overlap_count"
      ]
    },
    "value": {"type": "string"},
    "label_type": {"const": "neutral_metadata"},
    "emotion_label": {"const": false},
    "deception_label": {"const": false},
    "stress_label": {"const": false},
    "biometric_label": {"const": false}
  },
  "additionalProperties": false
}
