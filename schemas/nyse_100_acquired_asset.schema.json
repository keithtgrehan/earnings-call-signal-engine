{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NYSE 100 acquired asset",
  "type": "object",
  "required": [
    "asset_id",
    "case_id",
    "ticker",
    "company_name",
    "asset_type",
    "source_url",
    "source_type",
    "rights_status",
    "download_status",
    "blocked_reason",
    "local_path",
    "sha256",
    "content_type",
    "bytes",
    "created_at",
    "provenance_hash",
    "raw_git_committed"
  ],
  "properties": {
    "asset_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "ticker": {"type": "string", "minLength": 1},
    "company_name": {"type": "string", "minLength": 1},
    "asset_type": {"type": "string", "enum": ["transcript", "audio", "video_metadata", "metadata"]},
    "source_url": {"type": "string"},
    "source_type": {"type": "string"},
    "rights_status": {"type": "string"},
    "download_status": {"type": "string", "enum": ["downloaded", "metadata_only", "blocked", "failed", "not_attempted"]},
    "blocked_reason": {"type": "string"},
    "local_path": {"type": "string"},
    "sha256": {"type": "string"},
    "content_type": {"type": "string"},
    "bytes": {"type": ["integer", "string"]},
    "created_at": {"type": "string"},
    "provenance_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "raw_git_committed": {"type": "boolean", "const": false}
  },
  "additionalProperties": true
}
