{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-engine.local/schemas/llm_signal_candidates.schema.json",
  "title": "Signal Engine LLM Signal Candidate Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "provider",
    "model",
    "output_role",
    "canonical_output",
    "candidates"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "llm_signal_candidates.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "output_role": {"type": "string", "enum": ["candidate", "reviewer"]},
    "canonical_output": {"type": "boolean", "const": false},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "signal_type",
          "direction",
          "confidence",
          "rationale",
          "evidence"
        ],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "signal_type": {
            "type": "string",
            "enum": [
              "guidance_revision",
              "analyst_pressure",
              "management_hedging",
              "uncertainty",
              "reassurance",
              "opportunity_commitment",
              "risk_friction",
              "neutral",
              "no_signal"
            ]
          },
          "direction": {"type": "string", "enum": ["positive", "negative", "mixed", "neutral", "unknown"]},
          "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
          "rationale": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "provenance_ref",
                "speaker_role",
                "transcript_section",
                "quote"
              ],
              "properties": {
                "source_id": {"type": "string", "minLength": 1},
                "provenance_ref": {"type": "string", "minLength": 1},
                "speaker_role": {"type": "string", "minLength": 1},
                "transcript_section": {"type": "string", "minLength": 1},
                "quote": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
